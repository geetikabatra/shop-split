# Copy to .env for local development. Run `docker compose up -d` first to
# start a local Postgres matching these defaults.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopsplit_dev"

# Optional: enables shared-store (multi-instance-safe) rate limiting in
# app/utils/rate-limit.server.ts. Falls back to a single-process in-memory
# limiter if unset.
# REDIS_URL="redis://localhost:6379"

# Optional: enables error reporting in app/utils/sentry.server.ts. Errors
# are always logged locally regardless of whether this is set.
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
