# Copy to .env for local development. Run `docker compose up -d` first to
# start a local Postgres matching these defaults.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopsplit_dev"

# Prisma CLI (migrate/introspect) connection -- see the comment on
# directUrl in prisma/schema.prisma. Locally there's no pooler, so this is
# just the same value as DATABASE_URL. In production, behind a
# transaction-mode pooler (e.g. Supabase), this must be the direct/unpooled
# connection string while DATABASE_URL stays pooled.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shopsplit_dev"

# Optional: enables shared-store (multi-instance-safe) rate limiting in
# app/utils/rate-limit.server.ts. Falls back to a single-process in-memory
# limiter if unset.
# REDIS_URL="redis://localhost:6379"

# Optional: enables error reporting in app/utils/sentry.server.ts. Errors
# are always logged locally regardless of whether this is set.
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
